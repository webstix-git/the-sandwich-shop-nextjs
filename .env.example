# Google Analytics 4 measurement ID (omit to disable gtag).
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-SY7L9B15YD

# Contact form delivery (optional — pick one). Without these, submissions
# still succeed and redirect to thank-you, but only log server-side.
